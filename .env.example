# Copy this file to .env and fill in your values

APP_NAME=ArtMentor AI
APP_VERSION=0.1.0
DEBUG=false
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1
SERVER__HOST=127.0.0.1
SERVER__PORT=8000
ALLOWED_ORIGINS=["http://localhost:5173"]

OPENROUTER__API_KEY=your_openrouter_api_key
# Slugs from https://openrouter.ai/models (vendor/model). Use vision-capable models for image critique.
OPENROUTER__MODEL_NAME=anthropic/claude-haiku-4.5
OPENROUTER__MODEL_FALLBACKS=google/gemini-3-flash-preview
OPENROUTER__TIMEOUT_SECONDS=60
OPENROUTER__TEMPERATURE=0.3
OPENROUTER__APP_TITLE=ArtMentor AI
OPENROUTER__APP_URL=https://artmentorai.vercel.app

MAX_FILE_SIZE_MB=20

SUPABASE__URL=https://project_name.supabase.co
SUPABASE__JWT_AUD=authenticated
SUPABASE__ANON_KEY=anon_key
SUPABASE__SERVICE_ROLE_KEY=service_role_key
SUPABASE__GOOGLE_OAUTH_CLIENT_ID=google_oauth_client_id
SUPABASE__GOOGLE_OAUTH_CLIENT_SECRET=google_oauth_client_secret
SUPABASE__OAUTH_REDIRECT_URL=http://127.0.0.1:5173/sign-in

VITE_SUPABASE_URL=https://project_name.supabase.co
VITE_SUPABASE_ANON_KEY=anon_key
VITE_API_BASE_URL=https://artmentorai-api.fly.dev

QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_API_KEY=qdrant_api_key
EMBEDDING_CACHE_FOLDER=./embeddings_cache

WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=serper
WEB_SEARCH_API_KEY=serper_api_key
WEB_SEARCH_TIMEOUT_SECONDS=8
WEB_SEARCH_MAX_CALLS_PER_REQUEST=2
WEB_SEARCH_MAX_RESULTS=3
WEB_SEARCH_MAX_QUERY_CHARS=240
